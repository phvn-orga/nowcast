{
  "type": "object",
  "required": ["repo", "branch", "head_sha", "pr", "ci", "source"],
  "$defs": {
    "state": { "enum": ["queued", "waiting", "running", "pass", "fail", "cancelled", "skipped", "unknown"] },
    "time": { "type": ["string", "null"], "description": "RFC 3339." },
    "job": {
      "type": "object",
      "required": ["id", "name", "stage", "state", "warning", "required", "started_at", "finished_at", "url"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stage": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "warning": { "type": "boolean", "description": "A success with warnings." },
        "required": { "type": ["boolean", "null"], "description": "Null when the forge does not say." },
        "started_at": { "$ref": "#/$defs/time" },
        "finished_at": { "$ref": "#/$defs/time" },
        "url": { "type": ["string", "null"] }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["id", "name", "definition", "trigger", "raw_trigger", "attempt", "sha", "ref", "state", "warning", "required", "started_at", "finished_at", "url", "jobs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "definition": { "type": ["string", "null"], "description": "The file or definition the pipeline runs." },
        "trigger": { "enum": ["push", "pull_request", "merge_queue", "manual", "schedule", "downstream", "external", "other"] },
        "raw_trigger": { "type": "string", "description": "The forge's own value." },
        "attempt": { "type": "integer", "minimum": 1 },
        "sha": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "state": { "$ref": "#/$defs/state" },
        "warning": { "type": "boolean" },
        "required": { "type": ["boolean", "null"] },
        "started_at": { "$ref": "#/$defs/time" },
        "finished_at": { "$ref": "#/$defs/time" },
        "url": { "type": ["string", "null"] },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } }
      }
    },
    "ci": {
      "type": ["object", "null"],
      "required": ["state", "required_state", "missing_required", "jobs", "pipelines"],
      "properties": {
        "state": { "enum": ["none", "queued", "waiting", "running", "pass", "fail"] },
        "required_state": { "enum": ["none", "queued", "waiting", "running", "missing", "pass", "fail", null] },
        "missing_required": { "type": "array", "items": { "type": "string" } },
        "jobs": {
          "type": "object",
          "required": ["done", "total"],
          "properties": { "done": { "type": "integer" }, "total": { "type": "integer" } }
        },
        "pipelines": { "type": "array", "items": { "$ref": "#/$defs/pipeline" } }
      }
    }
  },
  "properties": {
    "repo": { "type": "string", "description": "The repository, normalized: github.com/<owner>/<name>." },
    "branch": { "type": "string" },
    "head_sha": { "type": ["string", "null"], "description": "The branch's head on the forge; null when the branch is not there." },
    "pr": {
      "type": ["object", "null"],
      "required": ["number", "state", "draft", "base", "head_sha", "url", "auto_merge", "queue", "dequeued"],
      "properties": {
        "number": { "type": "integer" },
        "state": { "enum": ["open", "merged", "closed"] },
        "draft": { "type": "boolean" },
        "base": { "type": "string" },
        "head_sha": { "type": "string" },
        "url": { "type": "string" },
        "auto_merge": {
          "type": ["object", "null"],
          "required": ["enabled_by", "method"],
          "properties": { "enabled_by": { "type": ["string", "null"] }, "method": { "type": ["string", "null"] } }
        },
        "queue": { "type": ["object", "null"], "description": "The PR's entry in its base's merge queue." },
        "dequeued": { "type": ["object", "null"], "description": "Why the PR left the merge queue without being merged." }
      }
    },
    "ci": { "$ref": "#/$defs/ci", "description": "The CI of the PR's head, or of the branch's head without a PR." },
    "source": {
      "type": "object",
      "required": ["status", "as_of"],
      "properties": {
        "status": { "enum": ["pending", "ok", "no_credentials", "unauthorized", "not_found", "rate_limited", "unreachable", "unreadable"] },
        "as_of": { "$ref": "#/$defs/time", "description": "The last successful reading." }
      }
    }
  }
}
