{
  "type": "object",
  "description": "A session as the brick keeps it. Fields the session never sent are null.",
  "required": ["session", "updated_at", "ended_at"],
  "properties": {
    "session": { "type": "string" },
    "updated_at": { "type": "string", "description": "Its last measure, RFC 3339." },
    "ended_at": { "type": ["string", "null"], "description": "Set once the session stopped." },
    "root": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "effort": { "type": ["string", "number", "null"] },
    "context": { "type": ["object", "null"] },
    "tokens": { "type": ["object", "null"] },
    "last_request_at": { "type": ["string", "null"] },
    "cache_ttl": { "enum": ["5m", "1h", null] },
    "cache_expires_at": { "type": ["string", "null"], "description": "last_request_at plus cache_ttl, one hour when unknown." },
    "cost_usd": { "type": ["number", "null"] }
  }
}
