# Started by nowcast.socket only, hence no [Install] section. The daemon exits
# on its own once unused; the socket starts it again on the next connection.
[Unit]
Description=nowcast
Requires=nowcast.socket
After=nowcast.socket

[Service]
# Where `cargo install --root ~/.local` puts the binary, see the README.
ExecStart=%h/.local/bin/nowcast daemon
# SIGTERM reaches the daemon alone, which stops its bricks through their
# protocol (`shutdown` first); whatever is left gets SIGKILL.
KillMode=mixed
